# `@PYTHON_PACKAGE_PREFIX@` is rendered from the base image before DNF runs.
# C/C++ compilers for building Python C extensions (psutil, greenlet, etc.)
gcc
gcc-c++

# needed by pip to fetch packages from git URLs
git-core

# Python headers for building C extensions
@PYTHON_PACKAGE_PREFIX@-devel

# build backends required by various packages in requirements.cachito
@PYTHON_PACKAGE_PREFIX@-flit-core
@PYTHON_PACKAGE_PREFIX@-hatch-fancy-pypi-readme
@PYTHON_PACKAGE_PREFIX@-hatch-vcs
@PYTHON_PACKAGE_PREFIX@-hatchling >= 1.27.0
@PYTHON_PACKAGE_PREFIX@-packaging >= 24.2

# used by most OpenStack packages as their build system
@PYTHON_PACKAGE_PREFIX@-pbr
@PYTHON_PACKAGE_PREFIX@-poetry-core

# pip and wheel for downloading and building wheels
@PYTHON_PACKAGE_PREFIX@-pip
@PYTHON_PACKAGE_PREFIX@-setuptools >= 78.1.1

# needed by bcrypt 4.x to compile its Rust-based _bcrypt extension
cargo
@PYTHON_PACKAGE_PREFIX@-setuptools-rust >= 1.9.0
@PYTHON_PACKAGE_PREFIX@-setuptools_scm

# test dependencies pulled in by some OpenStack packages at build time
@PYTHON_PACKAGE_PREFIX@-testresources >= 2.0.1
@PYTHON_PACKAGE_PREFIX@-testscenarios >= 0.5.0
@PYTHON_PACKAGE_PREFIX@-wheel
