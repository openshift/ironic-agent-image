#!/usr/bin/bash

# OKD Python setup script for ironic-agent-image
# Install the selected Python version of OpenStack packages via pip.

set -euo pipefail

. /bin/python-config.sh
configure_python

# This script assumes it's called only for OKD builds

echo "Installing Python ${PYTHON_VERSION} packages for OKD build (ironic-agent)"

# Install OpenStack packages from requirements file
if [[ -f /tmp/python-requirements.okd ]]; then
    echo "Installing OpenStack packages for Python ${PYTHON_VERSION} via pip"

    # Build-only deps for compiling C extensions (e.g. dbus-python).
    # Install and remove them in this layer so they do not persist in the image.
    build_deps=(
        gcc
        gcc-c++
        glib2-devel
        pkgconfig
        "${PYTHON_PACKAGE_PREFIX}-devel"
        dbus-devel
    )
    dnf install -y "${PYTHON_PACKAGE_PREFIX}-pip" "${build_deps[@]}"
    "${PYTHON_BIN}" -m pip install --no-cache-dir 'setuptools >= 70.3'

    "${PYTHON_BIN}" -m pip install --no-cache-dir --prefix /usr -c https://releases.openstack.org/constraints/upper/master -r /tmp/python-requirements.okd

    # Compile Python files for better performance
    "${PYTHON_BIN}" -m compileall --invalidation-mode=timestamp -q /usr

    PBR_VERSION=1.0 "${PYTHON_BIN}" -m pip install --no-build-isolation --no-index --verbose --prefix=/usr /tmp/hardware_manager

    dnf remove -y "${build_deps[@]}"
fi

echo "OKD setup completed successfully (ironic-agent)"
